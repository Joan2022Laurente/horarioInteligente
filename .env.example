# ==============================================================================
# VARIABLES DE ENTORNO DE EJEMPLO - HORARIO INTELIGENTE UTP
# Copia este archivo como .env y edita los valores según tu entorno local
# ==============================================================================

# 1. Base de Datos MySQL (Para MySQL Workbench)
# Si usas XAMPP por defecto:
MYSQL_URL=jdbc:mysql://localhost:3306/horariodb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DRIVER=com.mysql.cj.jdbc.Driver

# Si usas MySQL en la nube (Aiven, Clever Cloud, TiDB):
# MYSQL_URL=jdbc:mysql://<HOST>:<PORT>/<DATABASE>?useSSL=true&allowPublicKeyRetrieval=true
# MYSQL_USER=<USER>
# MYSQL_PASSWORD=<PASSWORD>



# 3. Gateway Académico Oficial UTP (Heroku)
ACADEMIC_GATEWAY_URL=https://utp-academic-gateway-c0da87808dcb.herokuapp.com/api/v1

# 4. Servicios de Inteligencia Artificial (OpenRouter API)
OPENROUTER_API_KEY=tu_openrouter_api_key
